# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Providers
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Auth (legacy — retained for WhatsApp webhook and businesses API until full Supabase auth migration)
API_SECRET_KEY=your-api-secret-key
NEXT_PUBLIC_API_SECRET_KEY=your-api-secret-key

# WhatsApp (Meta Business API v25.0)
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token

# App URL — used for document links returned by the generate_quote skill
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Optional: email notifications (Resend). Without these, email sends are skipped.
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=

# Optional: external HTML->PDF service (takes { html }, returns PDF bytes).
# Leave blank to use the bundled headless-Chromium renderer instead.
DOCUMENT_PDF_ENDPOINT=

# Google Workspace (Calendar / Drive / Docs) is NOT configured here — the
# service-account key is stored per business in businesses.google_workspace
# (dashboard). See docs/USER_ACTIONS_SPEC.md section 6.

# Optional: WhatsApp webhook fallback business when phone_number_id isn't matched
# and no business has is_default = true.
ACTIVE_BUSINESS_ID=
